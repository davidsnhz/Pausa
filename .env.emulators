# Modo emuladores (`npm run dev:emu`): Auth y Firestore corren en local con los
# emuladores de Firebase (`npm run emulators`). Proyecto "demo-pausa": nunca
# toca tus datos reales. Valores ficticios, se puede subir al repo sin problema.

VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-pausa.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-pausa
VITE_FIREBASE_STORAGE_BUCKET=demo-pausa.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=demo-app
VITE_AI_PROXY_URL=
# Para que /api/chat acepte los tokens del emulador de Auth (no van firmados).
# Sin VITE_: no llega al navegador. NUNCA en Vercel.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
