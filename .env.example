# Copia este archivo como `.env` y rellena con los valores de tu proyecto.
# (Consola de Firebase → Configuración del proyecto → Tus apps → SDK setup)
# Vite solo expone al frontend las variables que empiezan por VITE_.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# (Opcional) Endpoint propio de IA (Cloud Function que habla con Anthropic).
# La clave de la API vive SOLO en el backend, NUNCA aquí.
# Si se deja vacío, el chat usa respuestas de fallback en español.
VITE_AI_PROXY_URL=
