# Copia este archivo como `.env` y rellena con los valores de tu proyecto.
# (Consola de Firebase → Configuración del proyecto → Tus apps → SDK setup)
# Vite solo expone al frontend las variables que empiezan por VITE_.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# (Opcional) URL del endpoint de IA. Por defecto la app usa /api/chat (la
# función de Vercel en api/chat.js); solo hace falta para apuntar a otra URL.
# La clave de Anthropic (ANTHROPIC_API_KEY) va SOLO en las variables de Vercel,
# NUNCA aquí: todo lo que empieza por VITE_ acaba visible en el navegador.
VITE_AI_PROXY_URL=
